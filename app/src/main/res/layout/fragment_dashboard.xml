<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DashboardFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EAEAEA">


        <androidx.cardview.widget.CardView
            android:id="@+id/device_name_cardview"
            android:layout_width="179dp"
            android:layout_height="79dp"
            app:cardBackgroundColor="#1D254E"
            app:cardCornerRadius="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.068"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.019" />

        <androidx.cardview.widget.CardView
            android:id="@+id/os_version_cardview"
            android:layout_width="172dp"
            android:layout_height="81dp"
            app:cardBackgroundColor="#1D254E"
            app:cardCornerRadius="16dp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.933"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.019" >

            <ImageView
                android:id="@+id/android_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/android_icon_w"
                android:translationX="75dp"
                android:translationY="5dp" />

            <TextView
                android:id="@+id/os_version_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="android version"
                android:textColor="@color/white"
                android:translationX="45dp"
                android:translationY="28dp"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/os_version_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="android version name"
                android:textColor="@color/white"
                android:translationX="35dp"
                android:translationY="50dp"/>


        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/ram_usage_cardview"
            android:layout_width="366dp"
            android:layout_height="136dp"
            android:layout_marginTop="108dp"
            app:cardBackgroundColor="#022E47"

            app:cardCornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">




        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/chipset_cardView"
            android:layout_width="365dp"
            android:layout_height="35dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="29dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.363"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ram_usage_cardview">

            <TextView
                android:id="@+id/chipset_cardview_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="chipset name here"
                android:textColor="@color/black"
                android:gravity="center"
                />
        </androidx.cardview.widget.CardView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>